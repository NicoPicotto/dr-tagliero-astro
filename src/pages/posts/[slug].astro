---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Button } from "@/components/starwind/button";
import Container from "@/components/commons/container.astro";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import "@/styles/prose-lite.css";
import ArticleCard from "@/components/articles/article-card.astro";
import { Link } from "@lucide/astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const allBlogPosts = (await getCollection("blog"))
  .filter((p) => p.data.category === post.data.category && p.slug !== post.slug)
  .sort((a, b) => b.data.posted.getTime() - a.data.posted.getTime())
  .slice(0, 3);
const { Content } = await post.render();
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={`https://matiastagliero.com${post.data.imgSrc}`}
  canonical={`https://matiastagliero.com/posts/${post.slug}`}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.posted.toISOString()} />
    <meta property="article:section" content={post.data.category} />
    <meta property="article:author" content="Matías Tagliero" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": `https://matiastagliero.com/posts/${post.slug}`,
        },
        headline: post.data.title,
        description: post.data.description,
        articleSection: post.data.category,
        datePublished: post.data.posted.toISOString(),
        dateModified: post.data.posted.toISOString(),
        author: {
          "@type": "Person",
          "@id": "https://matiastagliero.com/#matias",
          name: "Matías Tagliero",
        },
        publisher: {
          "@type": "Person",
          "@id": "https://matiastagliero.com/#matias",
          name: "Matías Tagliero",
        },
        image: `https://matiastagliero.com${post.data.imgSrc}`,
        url: `https://matiastagliero.com/posts/${post.slug}`,
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Inicio", item: "https://matiastagliero.com/" },
          {
            "@type": "ListItem",
            position: 2,
            name: "Artículos",
            item: "https://matiastagliero.com/articulos/",
          },
          {
            "@type": "ListItem",
            position: 3,
            name: post.data.category,
            item: `https://matiastagliero.com/categorias/${encodeURIComponent(post.data.category)}/`,
          },
          { "@type": "ListItem", position: 4, name: post.data.title },
        ],
      })}
    />
  </Fragment>
  <Container>
    <article class="mb-20 mt-4">
      <div class="flex flex-col gap-4 justify-centermax-w-lg my-6">
        <div class="rounded-xl h-[25rem] overflow-hidden mb-4 flex items-center justify-center">
          <img
            src={post.data.imgSrc}
            alt={post.data.title}
            class="w-full h-auto object-cover object-center"
          />
        </div>
        <div class="grid grid-cols-9 relative">
          <div class="col-span-1 h-full">
            <div class="flex flex-col gap-4 items-center sticky top-35" id="share-buttons" data-title={post.data.title}>
              <a
                id="share-facebook"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir en Facebook"
              >
                <Button variant="outline">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-16 h-16"
                  >
                    <path
                      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    ></path>
                  </svg>
                </Button>
              </a>
              <a
                id="share-twitter"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir en Twitter"
              >
                <Button variant="outline">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-16 h-16"
                  >
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path>
                  </svg>
                </Button>
              </a>
              <a id="share-copy" href="#" aria-label="Copiar enlace">
                <Button variant="outline"><Link class="w-16 h-16" /></Button>
              </a>
            </div>
          </div>
          <div class="col-span-8 flex flex-col gap-4 max-w-prose">
            <Breadcrumb>
              <BreadcrumbList>
                <BreadcrumbItem>
                  <BreadcrumbLink href="/articulos">Artículos</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem>
                  <BreadcrumbLink href={`/categorias/${encodeURIComponent(post.data.category)}`}>
                    {post.data.category}
                  </BreadcrumbLink>
                </BreadcrumbItem>
              </BreadcrumbList>
            </Breadcrumb>
            <h1 class="max-w-prose text-4xl font-bold">{post.data.title}</h1>
            <p class="max-w-prose">{post.data.description}</p>
            <div
              class="max-w-prose h-px my-4 bg-[repeating-linear-gradient(to_right,#d82323_0_4px,transparent_4px,transparent_12px)]"
            >
            </div>
            <div>
              <div class="max-w-prose prose-lite"><Content /></div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- <Divider />
   <Container>
      <Tooltip>
         <TooltipTrigger>
            <Button variant='outline' size='sm'
               ><Link /> Compartí este artículo</Button
            >
         </TooltipTrigger>
         <TooltipContent side='right' class='text-sm bg-primary'>
            Click para copiar el enlace
         </TooltipContent>
      </Tooltip>
   </Container> -->
  </Container>
  {
    allBlogPosts.length > 0 && (
      <div class="py-20 bg-background-darker">
        <Container>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10">
            <div class="col-span-1 flex flex-col gap-6 h-fit">
              <h3 class="text-2xl font-bold">Artículos relacionados</h3>

              {allBlogPosts.map((post) => (
                <ArticleCard
                  title={post.data.title}
                  description={post.data.description}
                  imgSrc={post.data.imgSrc}
                  category={post.data.category}
                  href={`/posts/${post.slug}`}
                />
              ))}
            </div>
          </div>
        </Container>
      </div>
    )
  }
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const url = encodeURIComponent(window.location.href);
    const container = document.getElementById("share-buttons");
    const title = encodeURIComponent(container?.dataset.title ?? "");

    const fb = document.getElementById("share-facebook") as HTMLAnchorElement | null;
    if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;

    const tw = document.getElementById("share-twitter") as HTMLAnchorElement | null;
    if (tw) tw.href = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;

    const copy = document.getElementById("share-copy");
    if (copy) {
      copy.addEventListener("click", async (e) => {
        e.preventDefault();
        await navigator.clipboard.writeText(window.location.href);
        copy.style.outline = "2px solid #d82323";
        copy.style.outlineOffset = "2px";
        copy.style.borderRadius = "0.375rem";
        setTimeout(() => {
          copy.style.outline = "";
          copy.style.outlineOffset = "";
        }, 2000);
      });
    }
  });
</script>
</Layout>
