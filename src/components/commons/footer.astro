---
import Container from "@/components/commons/container.astro";
import { Button } from "@/components/starwind/button";
import { Mail, Phone, MapPin } from "@lucide/astro";
import { Image } from "astro:assets";
import footerImg from "@/assets/logo-horizontal.svg";
import { getCollection } from "astro:content";
const allBlogPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.posted.getTime() - a.data.posted.getTime())
  .slice(0, 5);
---

<footer class="w-full py-10 glass-footer">
  <Container>
    <div class="flex flex-col md:flex-row justify-between gap-10 text-sm text-gray-200">
      <div class="flex flex-col gap-10 justify-between">
        <Image
          loading="eager"
          decoding="async"
          class="h-16 w-fit"
          src={footerImg}
          alt="logo horizontal"
        />
        <div class="flex flex-col gap-1">
          <Button
            variant="link"
            class="w-fit px-0 h-fit py-0"
            href="mailto:hola@matiastagliero.com"
            size="sm"
          >
            <Mail size="14" />
            hola@matiastagliero.com
          </Button>
          <Button
            variant="link"
            class="w-fit px-0 h-fit py-0"
            href="https://wa.me/5493513884467?text=Hola%2C%20me%20gustaría%20hacer%20una%20consulta..."
            target="_blank"
            rel="noopener noreferrer"
            size="sm"
          >
            <Phone size="14" />
            +54 935 13884467
          </Button>
          <Button
            variant="link"
            class="w-fit px-0 h-fit py-0 mt-1"
            href="https://maps.google.com/?q=Saavedra+365,+General+Deheza,+C%C3%B3rdoba"
            target="_blank"
            rel="noopener noreferrer"
            size="sm"
          >
            <MapPin size="14" />
            Saavedra 365, General Deheza, Córdoba.
          </Button>
        </div>
      </div>
      <div class="flex flex-col md:flex-row gap-10 md:gap-30">
        <div>
          <h2 class="text-lg font-semibold mb-2">Navegación</h2>
          <div class="flex flex-col gap-2">
            <a href="/">Inicio</a>
            <a href="/#sobre-mi">Sobre Mí</a>
            <a href="/articulos">Artículos</a>
            <a href="/contacto">Contacto</a>
          </div>
        </div>
        <div>
          <h2 class="text-lg font-semibold mb-2">Últimos artículos</h2>
          <div class="flex flex-col gap-2">
            {
              allBlogPosts.map((post) => (
                <a href={`/posts/${post.slug}`} class="inline-block max-w-[400px] truncate">
                  {post.data.title}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</footer>
